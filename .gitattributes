# lock line endings across platforms: linux-side scripts must be lf, windows scripts crlf
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.php  text eol=lf
*.json text eol=lf
*.template text eol=lf
*.txt  text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf
