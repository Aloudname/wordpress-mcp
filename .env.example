# deployment settings for deploy.sh and install.ps1.
# copy to .env (gitignored) and fill in; never commit or deploy it.
# precedence: command-line flag > environment variable > .env > built-in default.

# ssh destination of the wordpress host, e.g. user@host or deploy@blog.example.com.
# key-based login must work without a password prompt.
MCP_SSH_HOST=

# absolute install dir on that host, e.g. /home/user/wordpress-mcp.
# must match the dir passed to install.sh --server-dir.
# keep it to letters, digits, ".", "_", "/", "-"; spaces are rejected.
MCP_SERVER_DIR=
