# [wordpress-mcp] generated by install.sh from a template; uninstall.sh
# removes this file; do not edit
# mcp-only loopback entry: binds 127.0.0.1, https + application password auth
# no caching on purpose: mcp editing tools must read fresh content
server {
    listen 127.0.0.1:{{PORT}} ssl;
    ssl_certificate /etc/nginx/ssl/loopback.crt;
    ssl_certificate_key /etc/nginx/ssl/loopback.key;
    server_name _;
    root {{WP_ROOT}};
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass unix:{{PHP_SOCKET}};
    }

    location ~* /wp-config.php { deny all; }
    client_max_body_size 50M;
}
