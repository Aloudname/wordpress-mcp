#!/bin/sh
# mcp stdio entry point, invoked by clients over ssh:
#   ssh user@host /home/user/wordpress-mcp/bin/mcp-server
set -eu
# shellcheck disable=SC1007  # CDPATH= prefix is the posix-safe cd idiom; the space is intentional
DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$DIR"   # python -m resolves the package from cwd
exec "$DIR/venv/bin/python" -m wordpress_mcp
